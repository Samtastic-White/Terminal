# Example only: every entry is commented out, the app and Compose start with
# an empty environment. Uncomment a line to override its default.

# --- Application (optional) -------------------------------------------------
# Diagnostics filter. Default: warn. RUST_LOG is only a fallback.
# NT_LOG=info
# RUST_LOG=warn
# Non-empty value disables ANSI color even on a TTY.
# NO_COLOR=1
# Phase 0 idle/pacing probe. Only the exact value 1 enables it.
# NT_MEASURE=1

# --- Compose / graphical host (optional) ------------------------------------
# Container user mapping, must match the host user that owns the checkout.
# DEV_UID=1000
# DEV_GID=1000
# Wayland session socket. Compose defaults to /run/user/1000 + wayland-0.
# XDG_RUNTIME_DIR=/run/user/1000
# WAYLAND_DISPLAY=wayland-0
# X11 only; leave unset on a pure Wayland host.
# DISPLAY=:0
